---
permalink: feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
  <title>{{ site.name }}</title>
  <link>{{ site.url }}/</link>
  <description>{{ site.description }}</description>
  <language>en</language>
  <atom:link xmlns:atom="http://www.w3.org/2005/Atom" href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
  {%- for post in collections.posts %}
  <item>
    <title>{{ post.data.title }}</title>
    <link>{{ site.url }}{{ post.url }}</link>
    <guid>{{ site.url }}{{ post.url }}</guid>
    <pubDate>{{ post.data.date | rfc822Date }}</pubDate>
    {%- if post.data.verdict %}
    <category>{{ post.data.verdict }}</category>
    {%- endif %}
    <description>{{ post.data.claim }}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
